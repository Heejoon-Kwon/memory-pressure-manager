{
  "manifest_version": 3,
  "name": "Probe · 탭 메모리 관리",
  "version": "1.0.0",
  "description": "메모리 압박 시 사용자가 허용한 탭만 메모리에서 내립니다.",
  "permissions": ["tabs", "storage", "alarms", "nativeMessaging"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Probe 탭 관리", "default_popup": "popup.html"}
}
