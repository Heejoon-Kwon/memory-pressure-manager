{
  "manifest_version": 3,
  "name": "Memora · 탭 메모리 관리",
  "version": "1.1.0",
  "description": "메모리 압박 시 사용자가 허용한 탭만 메모리에서 내립니다.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "nativeMessaging",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Memora 탭 관리",
    "default_popup": "popup.html"
  }
}
